---
import Base from '../../layouts/Base.astro';
import Helpline from '../../components/Helpline.astro';
import type { Lang } from '../../data/categories';
import { VIDEOS, title } from '../../data/videos';
import { REFERRALS } from '../../data/referrals';
import { FH } from '../../i18n/findHelp';
import { tr, num, href } from '../../i18n/ui';
import { SITE } from '../../config';
import { ICON } from '../../components/icons';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'en' } }];
}
const lang: Lang = Astro.params.lang === 'en' ? 'en' : 'bn';
const t = tr(lang);
const f = FH[lang];
const needs = ['talk', 'counselling', 'psychiatry', 'child', 'addiction', 'emergency'] as const;
const pretty = (n: string) => (lang === 'bn' ? n.replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[+d]) : n);
const shown = (n: string) => {
  // 09612119911 -> 09612-119911, 01776632344 -> 01776-632344
  const m = n.match(/^(0\d{4})(\d{6})$/);
  return pretty(m ? `${m[1]}-${m[2]}` : n);
};
const fmt = new Intl.DateTimeFormat(lang === 'bn' ? 'bn-BD' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const date = (d: string) => fmt.format(new Date(d + 'T12:00:00Z'));
const prepVideos = f.prepVideos.map((id) => VIDEOS.find((v) => v.id === id)!).filter(Boolean);
const cfg = { all: f.all, explain: Object.fromEntries(needs.map((n) => [n, f.needs[n].explain])) };
---
<Base lang={lang} path="find-help" nav="help" title={f.title} description={f.lead}>
  <div class="wrap fh">
    <header class="head">
      <h1>{f.title}</h1>
      <p class="lead">{f.lead}</p>
      <p class="notice" role="note">{f.notice}</p>
    </header>

    <section class="emergency" aria-labelledby="em-h">
      <div>
        <h2 id="em-h">{f.emergencyTitle}</h2>
        <p>{f.emergencyBody}</p>
      </div>
      <a class="btn btn-warm" href={`tel:${SITE.emergencyNumber}`}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICON.phone} /></svg>{t.callEmergency(num(SITE.emergencyNumber, lang))}
      </a>
    </section>

    <section aria-labelledby="need-h" class="need">
      <div>
        <h2 id="need-h">{f.needTitle}</h2>
        <p class="muted">{f.needLead}</p>
      </div>
      <div class="chips" role="group" aria-label={f.needTitle} id="need-chips">
        <button type="button" class="chip" data-need="all" aria-pressed="true">{f.all}</button>
        {needs.map((n) => <button type="button" class="chip" data-need={n} aria-pressed="false">{f.needs[n].label}</button>)}
      </div>
      <p class="explain" id="explain" role="status" hidden></p>
    </section>

    <section aria-label={f.title} id="directory">
      <ul class="cards">
        {REFERRALS.map((r) => (
          <li class="card" data-needs={r.needs.join(' ')}>
            <div class="card-head">
              <span class={`kind kind-${r.kind}`}>{f.kinds[r.kind]}</span>
              <h3>{r.name[lang]}</h3>
            </div>
            <p class="about">{r.about[lang]}</p>
            <dl>
              {r.phones && (
                <div><dt>{f.phone}</dt><dd>{r.phones.map((p) => <a class="ph" href={`tel:${p.number}`}>{shown(p.number)}</a>)}{r.phones[0].label && <span class="muted"> · {r.phones[0].label[lang]}</span>}</dd></div>
              )}
              {r.hours && <div><dt>{f.hours}</dt><dd>{r.hours[lang]}</dd></div>}
              {r.address && <div><dt>{f.where}</dt><dd>{r.address[lang]}</dd></div>}
              {r.cost && <div><dt>{f.cost}</dt><dd>{r.cost[lang]}</dd></div>}
              {r.how && <div><dt>{f.note}</dt><dd>{r.how[lang]}</dd></div>}
              {r.web && <div><dt>{f.website}</dt><dd><a href={r.web.url} target="_blank" rel="noopener noreferrer">{r.web.label} ↗</a></dd></div>}
            </dl>
            {r.phones && <a class="btn card-call" href={`tel:${r.phones[0].number}`}>{f.callBtn(shown(r.phones[0].number))}</a>}
            <p class="checked">{f.checked(date(r.checked))}</p>
          </li>
        ))}
      </ul>
      <p class="verify">{f.verifyNote}</p>
    </section>

    <section class="prep" aria-labelledby="prep-h">
      <h2 id="prep-h">{f.prepTitle}</h2>
      <ol class="prep-list">
        {f.prep.map((p, i) => (
          <li><span class="step">{num(i + 1, lang)}</span><div><h3>{p.t}</h3><p>{p.b}</p></div></li>
        ))}
      </ol>
      <p class="watch"><strong>{f.watchLabel}</strong>
        {prepVideos.map((v) => <a href={href(lang, `watch/${v.id}`)}>{title(v, lang)}</a>)}
      </p>
    </section>

    <section class="pros" aria-labelledby="pros-h">
      <div><h2 id="pros-h">{f.prosTitle}</h2><p>{f.prosBody}</p></div>
      <a class="btn" href={href(lang, 'professionals')}>{f.prosBtn}</a>
    </section>

    <section class="ask" aria-labelledby="ask-h">
      <h2 id="ask-h">{f.askTitle}</h2>
      <p>{f.askBody}</p>
      <div class="ask-row">
        <a class="btn btn-white" href={href(lang, 'contact') + '?topic=referral'}>{f.askBtn}</a>
        <span class="warn">{f.askWarn}</span>
      </div>
    </section>

    <Helpline lang={lang} />
  </div>

  <script type="application/json" id="fh-cfg" set:html={JSON.stringify(cfg)} />
  <script src="../../scripts/find-help.ts"></script>
</Base>

<style>
  .fh { padding-top: 48px; padding-bottom: 24px; display: flex; flex-direction: column; gap: 48px; max-width: 1000px; }
  .head { display: flex; flex-direction: column; gap: 12px; }
  .lead { font-size: 21px; color: var(--ink-2); max-width: 36em; }
  .notice { padding: 14px 18px; border-radius: 12px; background: var(--sand); border: 1px solid var(--line); font-size: 16px; max-width: 44em; }
  .emergency { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding: 24px 28px; border-radius: 16px; background: var(--warm-bg); border: 1px solid var(--warm-line); color: #4a3326; }
  .emergency h2 { font-size: 22px; color: var(--warm-ink); }
  .emergency > div { flex: 1 1 340px; display: flex; flex-direction: column; gap: 4px; }
  .need { display: flex; flex-direction: column; gap: 16px; }
  .explain { padding: 16px 20px; border-radius: 12px; background: var(--teal-tint); color: #0b4a44; font-size: 17px; border: 1px solid #b5dcd5; }
  .explain.urgent { background: var(--warm-bg); border-color: var(--warm-line); color: var(--warm-ink); font-weight: 600; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(420px, 1fr)); gap: 18px; }
  .card { display: flex; flex-direction: column; gap: 12px; padding: 24px; border: 1px solid var(--line); border-radius: 16px; background: #fff; }
  .card-head { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .card h3 { font-size: 21px; line-height: 1.4; }
  .kind { font-size: 13px; font-weight: 700; padding: 2px 10px; border-radius: 999px; }
  .kind-helpline { background: var(--teal-tint); color: #0b4a44; }
  .kind-government { background: #e3eef6; color: #1f4a68; }
  .kind-university { background: #ece8f4; color: #44386b; }
  .kind-private { background: #f3ead6; color: #5b4a1f; }
  .about { font-size: 17px; color: var(--ink-2); }
  dl { margin: 0; display: flex; flex-direction: column; gap: 8px; font-size: 16px; }
  dl > div { display: flex; flex-wrap: wrap; gap: 2px 12px; }
  dt { flex: 0 0 76px; font-weight: 700; color: var(--ink-3); font-size: 14px; padding-top: 2px; }
  dd { margin: 0; flex: 1 1 220px; min-width: 0; }
  .ph { font-weight: 700; margin-right: 12px; white-space: nowrap; }
  .card-call { align-self: flex-start; margin-top: auto; }
  .checked { font-size: 13px; color: var(--ink-3); }
  .verify { font-size: 14px; color: var(--ink-3); max-width: 48em; padding-top: 16px; }
  .prep { display: flex; flex-direction: column; gap: 20px; }
  .prep-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .prep-list li { display: flex; gap: 14px; padding: 20px; background: #fff; border: 1px solid var(--line); border-radius: 14px; }
  .step { flex: 0 0 36px; width: 36px; height: 36px; border-radius: 50%; border: 1.5px solid var(--teal); color: var(--teal); display: flex; align-items: center; justify-content: center; font-weight: 700; }
  .prep-list h3 { font-size: 18px; margin-bottom: 4px; }
  .prep-list p { font-size: 16px; color: var(--ink-2); }
  .watch { display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: baseline; font-size: 16px; }
  .pros { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding: 28px; border-radius: 16px; background: #fff; border: 1.5px solid var(--teal); }
  .pros > div { flex: 1 1 360px; display: flex; flex-direction: column; gap: 6px; }
  .pros p { color: var(--ink-2); max-width: 40em; }
  .ask { display: flex; flex-direction: column; gap: 12px; padding: 32px; border-radius: 16px; background: var(--teal); color: #fff; }
  .ask p { color: #ddf0ec; max-width: 40em; }
  .ask-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  .warn { font-size: 14px; color: #ddf0ec; }
  @media (max-width: 640px) {
    .fh { padding-top: 28px; gap: 36px; }
    .cards { grid-template-columns: minmax(0, 1fr); }
    .card, .ask, .emergency { padding: 20px; }
    .chips { flex-wrap: wrap; overflow: visible; margin: 0; padding: 0; }
    .chip { font-size: 16px; }
  }
</style>
