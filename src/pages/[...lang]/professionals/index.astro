---
import Base from '../../../layouts/Base.astro';
import '../../../styles/pros.css';
import type { Lang } from '../../../data/categories';
import { TYPES, MODES, LANGUAGES, AGES, SPECIALIZATIONS } from '../../../data/professionals';
import { PR } from '../../../i18n/pros';
import { REFERRALS } from '../../../data/referrals';
import { href, num, tr } from '../../../i18n/ui';
import { SITE } from '../../../config';
import { ICON } from '../../../components/icons';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'en' } }];
}
const lang: Lang = Astro.params.lang === 'en' ? 'en' : 'bn';
const p = PR[lang];
const pl = p.places;
const t = tr(lang);
const needs = ['talk', 'counselling', 'psychiatry', 'child', 'addiction'] as const;
const pretty = (n: string) => (lang === 'bn' ? n.replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[+d]) : n);
// 09612119911 -> 09612-119911
const shown = (n: string) => { const m = n.match(/^(0\d{4})(\d{6})$/); return pretty(m ? `${m[1]}-${m[2]}` : n); };
const fmt = new Intl.DateTimeFormat(lang === 'bn' ? 'bn-BD' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const date = (d: string) => fmt.format(new Date(d + 'T12:00:00Z'));
const placesCfg = { explain: Object.fromEntries(needs.map((n) => [n, pl.needs[n].explain])), count: pl.count('{n}'), numerals: lang === 'bn' };
const cfg = {
  lang,
  step: 10,
  t: {
    results: p.results('{n}'), showResults: p.showResults('{n}'), shown: p.shown('{a}', '{b}'), call: p.call, details: p.details, hide: p.hide, qualifications: p.qualifications, languages: p.languages,
    ages: p.ages, fee: p.fee, availability: p.availability, address: p.address, website: p.website, email: p.email, report: p.report, onlineAnywhere: p.onlineAnywhere,
    error: p.error, empty: p.empty, emptyHint: p.emptyHint, emptyAll: p.emptyAll, notConnected: p.notConnected, clear: p.clear, anywhere: lang === 'bn' ? 'অনলাইন সেবা দেন এমন সবাইকেও দেখান' : 'Also show professionals who work online from anywhere',
    verifiedLabels: p.verified, verifiedHints: p.verifiedHint, fVerifiedOnly: p.fVerifiedOnly,
    allDistricts: p.fAnyLocation, showFilters: p.showFilters, hideFilters: p.hideFilters, filters: p.filters, moreSpecs: lang === 'bn' ? 'আরও দক্ষতা দেখুন' : 'Show more specializations', lessSpecs: lang === 'bn' ? 'কম দেখুন' : 'Show fewer',
  },
  contact: href(lang, 'contact'),
};
const opts = (list: { value: string; bn: string; en: string }[]) => list.map((o) => ({ value: o.value, label: o[lang] }));
const dirOn = Boolean(SITE.supabase.url && SITE.supabase.key);
---
<Base lang={lang} path="professionals" nav="pros" title={p.title} description={p.lead}>
  {dirOn && <link slot="head" rel="preconnect" href={new URL(SITE.supabase.url).origin} crossorigin />}
  <div class="wrap dir">
    <header class="head">
      <div>
        <h1 style="font-size: clamp(28px, 3.6vw, 40px)">{p.title}</h1>
        <p class="lead">{p.sub}</p>
      </div>
      <a class="sos" href={`tel:${SITE.emergencyNumber}`}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICON.phone} /></svg>
        <span><small>{pl.emergency}</small> {pl.callEmergency(num(SITE.emergencyNumber, lang))}</span>
      </a>
    </header>

    <div class="tabs" role="tablist" aria-label={p.title}>
      <button type="button" role="tab" id="tab-pros" aria-controls="panel-pros" aria-selected="true">{pl.tabPros}</button>
      <button type="button" role="tab" id="tab-places" aria-controls="panel-places" aria-selected="false" tabindex="-1">{pl.tabPlaces}</button>
    </div>

    <div class="panel" id="panel-pros" role="tabpanel" aria-labelledby="tab-pros">
    <details class="safe">
      <summary><span class="safe-t">{p.noticeShort}</span><span class="safe-l">{p.knowTitle}</span></summary>
      <p class="notice" role="note">{p.notice}</p>
      <h2 class="safe-h">{p.safeTitle}</h2>
      <dl>
        {p.safeItems.map(([h, b]) => (<><dt>{h}</dt><dd>{b}</dd></>))}
      </dl>
      <p class="muted" style="font-size:14px">{p.safeNote}</p>
    </details>

    <div class="dir-top">
      <div class="dir-search">
        <label for="d-q">{p.searchLabel}</label>
        <div class="field">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#555c62" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
          <input id="d-q" type="search" placeholder={p.searchPlaceholder} autocomplete="off" />
        </div>
      </div>
      <button type="button" class="filters-btn" id="filters-btn" aria-expanded="false" aria-controls="d-filters" aria-label={p.showFilters}>
        <svg class="fb-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" /></svg>
        <span class="fb-label">{p.filters}</span>
        <span class="fb-count" id="filters-count" hidden></span>
        <svg class="fb-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
      </button>
    </div>


    <div class="dir-body" id="dir-body">
      <aside class="dir-filters" id="d-filters" aria-label={p.filters}>
        <fieldset class="fgroup"><legend>{p.fVerified}</legend>
          <label class="fopt"><input type="checkbox" id="d-verified" /><span>{p.fVerifiedOnly}</span><span class="n" id="d-verified-n"></span></label>
        </fieldset>
        <fieldset class="fgroup" data-facet="type"><legend>{p.fType}</legend>
          {opts(TYPES).map((o) => (<label class="fopt"><input type="checkbox" data-facet="type" value={o.value} /><span>{o.label}</span><span class="n"></span></label>))}
        </fieldset>
        <fieldset class="fgroup" data-facet="mode"><legend>{p.fMode}</legend>
          {opts(MODES).map((o) => (<label class="fopt"><input type="checkbox" data-facet="mode" value={o.value} /><span>{o.label}</span><span class="n"></span></label>))}
        </fieldset>
        <div class="fgroup">
          <label for="d-district" style="font-size:14px;font-weight:700;color:var(--ink-3)">{p.fLocation}</label>
          <select id="d-district"><option value="">{p.fAnyLocation}</option></select>
          <label class="fopt" id="anywhere-wrap" hidden><input type="checkbox" id="d-anywhere" /><span>{cfg.t.anywhere}</span></label>
        </div>
        <fieldset class="fgroup" data-facet="spec"><legend>{p.fSpec}</legend>
          {opts(SPECIALIZATIONS).map((o, i) => (<label class="fopt" data-extra={i >= 9 ? '1' : undefined}><input type="checkbox" data-facet="spec" value={o.value} /><span>{o.label}</span><span class="n"></span></label>))}
          <button type="button" class="toggle-more" id="spec-more" aria-expanded="false">{cfg.t.moreSpecs}</button>
        </fieldset>
        <fieldset class="fgroup" data-facet="speak"><legend>{p.fLang}</legend>
          {opts(LANGUAGES).map((o) => (<label class="fopt"><input type="checkbox" data-facet="speak" value={o.value} /><span>{o.label}</span><span class="n"></span></label>))}
        </fieldset>
        <fieldset class="fgroup" data-facet="age"><legend>{p.fAge}</legend>
          {opts(AGES).map((o) => (<label class="fopt"><input type="checkbox" data-facet="age" value={o.value} /><span>{o.label}</span><span class="n"></span></label>))}
        </fieldset>
        <div class="fsheet-foot">
          <button type="button" class="linkbtn" data-clear id="f-clear" hidden>{p.clear}</button>
          <button type="button" class="btn" id="f-apply"></button>
        </div>
      </aside>

      <section class="dir-main" aria-live="polite">
        <div class="dir-bar">
          <p><strong id="d-count"></strong></p>
          <label class="sort">{p.sort}
            <select id="d-sort">
              <option value="rel" hidden disabled>{p.sortRel}</option>
              <option value="new">{p.sortNew}</option>
              <option value="name">{p.sortName}</option>
            </select>
          </label>
        </div>
        <div class="active-filters" id="d-active" hidden></div>
        {/* Placeholders are in the HTML (not added by the script) so the section below does not jump when listings load. */}
        <div id="d-list" class="pcards">{dirOn && <><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div></>}</div>
        <div id="d-more" style="display:flex;flex-direction:column;align-items:center;gap:8px;padding-top:8px" hidden>
          <button type="button" class="btn btn-outline" id="d-more-btn">{p.more}</button>
          <span class="muted" id="d-progress" style="font-size:14px"></span>
        </div>
      </section>
    </div>

    </div>

    <div class="panel" id="panel-places" role="tabpanel" aria-labelledby="tab-places" hidden>
      <div class="pl-intro">
        <p class="muted">{pl.lead}</p>
        <div class="chips" role="group" aria-label={pl.needLabel} id="need-chips">
          <button type="button" class="chip" data-need="all" aria-pressed="true">{pl.all}</button>
          {needs.map((n) => <button type="button" class="chip" data-need={n} aria-pressed="false">{pl.needs[n].label}</button>)}
        </div>
        <p class="explain" id="explain" role="status" hidden></p>
      </div>
      <p class="pl-count"><strong id="pl-count"></strong></p>
      <ul class="places">
        {REFERRALS.map((r) => (
          <li class="place" data-needs={r.needs.join(' ')}>
            <div class="pl-head">
              <h2>{r.name[lang]}</h2>
              <span class={`kind kind-${r.kind}`}>{pl.kinds[r.kind]}</span>
            </div>
            <p class="pl-about">{r.about[lang]}</p>
            <dl class="pl-facts">
              {r.phones && (
                <div><dt>{pl.phone}</dt><dd>{r.phones.map((ph) => <a class="ph" href={`tel:${ph.number}`}>{shown(ph.number)}</a>)}{r.phones[0].label && <span class="muted"> · {r.phones[0].label[lang]}</span>}</dd></div>
              )}
              {r.hours && <div><dt>{pl.hours}</dt><dd>{r.hours[lang]}</dd></div>}
              {r.address && <div><dt>{pl.where}</dt><dd>{r.address[lang]}</dd></div>}
              {r.cost && <div><dt>{pl.cost}</dt><dd>{r.cost[lang]}</dd></div>}
              {r.how && <div><dt>{pl.note}</dt><dd>{r.how[lang]}</dd></div>}
              {r.web && <div><dt>{pl.website}</dt><dd><a href={r.web.url} target="_blank" rel="noopener noreferrer">{r.web.label} ↗</a></dd></div>}
            </dl>
            <div class="pl-foot">
              {r.phones ? <a class="btn" href={`tel:${r.phones[0].number}`}>{pl.callBtn(shown(r.phones[0].number))}</a> : <span></span>}
              <span class="muted pl-checked">{pl.checked(date(r.checked))}</span>
            </div>
          </li>
        ))}
      </ul>
      <p class="muted pl-verify">{pl.verifyNote}</p>
      <section class="pl-ask" aria-labelledby="pl-ask-h">
        <div><h2 id="pl-ask-h">{pl.askTitle}</h2><p>{pl.askBody}</p></div>
        <a class="btn btn-outline" href={href(lang, 'contact') + '?topic=referral'}>{pl.askBtn}</a>
      </section>
    </div>

    <section class="dir-join" aria-labelledby="dj-h">
      <div><h2 id="dj-h">{p.joinTitle}</h2><p>{p.joinBody}</p></div>
      <a class="btn btn-white" href={href(lang, 'professionals/join')}>{p.joinBtn}</a>
    </section>
  </div>
  <script type="application/json" id="dir-cfg" set:html={JSON.stringify(cfg)} />
  <script type="application/json" id="places-cfg" set:html={JSON.stringify(placesCfg)} />
  <script src="../../../scripts/professionals.ts"></script>
  <script src="../../../scripts/places.ts"></script>
</Base>
