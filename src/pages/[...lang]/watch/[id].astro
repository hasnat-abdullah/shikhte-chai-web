---
import Base from '../../../layouts/Base.astro';
import VideoCard from '../../../components/VideoCard.astro';
import Player from '../../../components/Player.astro';
import type { Lang } from '../../../data/categories';
import { CAT, CATEGORIES } from '../../../data/categories';
import { VIDEOS, title, shareImage, isoDuration, byCat, meta, formatViews, formatDate, formatDuration, cleanDesc } from '../../../data/videos';
import { tr, num, href } from '../../../i18n/ui';
import { SITE } from '../../../config';
import Comments from '../../../components/Comments.astro';
import JsonLd from '../../../components/JsonLd.astro';
import Thumb from '../../../components/Thumb.astro';

export function getStaticPaths() {
  return [undefined, 'en'].flatMap((lang) => VIDEOS.map((v) => ({ params: { lang, id: v.id } })));
}
const lang: Lang = Astro.params.lang === 'en' ? 'en' : 'bn';
const t = tr(lang);
const v = VIDEOS.find((x) => x.id === Astro.params.id)!;
const c = CAT[v.cat];
const series = byCat(v.cat);
const idx = series.findIndex((x) => x.id === v.id);
const prev = series[idx - 1];
const next = series[idx + 1];
// Suggestions from neighbouring topics of the same shelf.
const sameShelf = CATEGORIES.filter((x) => x.shelf === c.shelf && x.id !== v.cat);
const also = sameShelf
  .map((x, i) => {
    const list = byCat(x.id);
    return list[(idx + i) % list.length];
  })
  .slice(0, 3);
// Topics with few neighbours: fill up from later videos of the same topic.
for (let k = 1; also.length < 3 && k < series.length; k++) {
  const extra = series[(idx + k) % series.length];
  if (extra.id !== v.id && !also.includes(extra)) also.push(extra);
}
const pageUrl = new URL(href(lang, `watch/${v.id}`), SITE.url).href;
const yt = `https://www.youtube.com/watch?v=${v.id}`;
const m = meta(v.id);
const desc = cleanDesc(m?.desc ?? '');
const PAGE = 5;
const pages = Math.ceil(series.length / PAGE);
// The first page of the topic list and the clamped description are rendered in the HTML, so nothing moves
// when the script starts (it used to shift the page by up to a tenth of the screen).
const page0 = Math.floor(idx / PAGE);
const longDesc = desc.length > 160 || desc.split('\n').length > 3;
const arrowless = (x: string) => x.replace(/[←→]/g, '').trim();
const dig = (x: string) => (lang === 'bn' ? x.replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[+d]) : x);
const when = m ? formatDate(m.date, lang) : '';
const length = m ? dig(formatDuration(m.secs)) : '';
// Search-result snippet: YouTube's own description when it is a real sentence in the page's language, otherwise a
// written one (English pages always use the written one, since the YouTube descriptions are in Bangla).
const clip = (s: string, n = 158) => (s.length <= n ? s : s.slice(0, n).replace(/\s+\S*$/, '') + '…');
const firstLine = desc.split('\n')[0].replace(/^[•\-–\s]+/, '');
const metaDesc = clip(lang === 'bn' && firstLine.length >= 70 ? firstLine : t.watchMeta(title(v, lang), c[lang]));
const abs = (path: string) => new URL(href(lang, path), SITE.url).href;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'VideoObject',
      '@id': `${pageUrl}#video`,
      name: title(v, lang),
      description: desc || `${title(v, lang)} · ${c[lang]}`,
      thumbnailUrl: [shareImage(v.id).url, `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`],
      ...(m?.date && { uploadDate: `${m.date}T00:00:00+06:00` }),
      ...(m?.secs && { duration: isoDuration(m.secs) }),
      embedUrl: `https://www.youtube.com/embed/${v.id}`,
      url: pageUrl,
      inLanguage: 'bn',
      isFamilyFriendly: true,
      genre: c[lang],
      ...(m && { interactionStatistic: { '@type': 'InteractionCounter', interactionType: { '@type': 'WatchAction' }, userInteractionCount: m.views } }),
      publisher: { '@id': `${SITE.url}/#org` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t.nav.home, item: abs('') },
        { '@type': 'ListItem', position: 2, name: t.nav.videos, item: abs('videos') },
        { '@type': 'ListItem', position: 3, name: c[lang], item: abs('videos') + `?cat=${v.cat}` },
        { '@type': 'ListItem', position: 4, name: title(v, lang) },
      ],
    },
  ],
};
---
<Base lang={lang} path={`watch/${v.id}`} nav="videos" title={title(v, lang)} description={metaDesc} image={shareImage(v.id).url} imageSize={shareImage(v.id).size} ogType="video.other">
  <JsonLd slot="head" data={[ld]} />
  <div class="wrap watch">
    <nav class="crumbs" aria-label={t.breadcrumb}>
      <a href={href(lang, 'videos')}>{t.nav.videos}</a> <span aria-hidden="true">/</span>
      <a href={href(lang, 'videos') + `?cat=${v.cat}`}>{c[lang]}</a>
    </nav>

    <div class="layout">
      <article class="main-col">
        <Player id={v.id} name={title(v, lang)} lang={lang} bg={c.ink} />

        <div class="meta">
          <h1>{title(v, lang)}</h1>
          <p class="stats">
            {m && (
              <span class="st">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
                <span>{formatViews(m.views, lang)}</span>
              </span>
            )}
            {when && (
              <span class="st">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
                <span>{when}</span>
              </span>
            )}
            {length && (
              <span class="st">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                <span>{length}</span>
              </span>
            )}
            <a class="pill" href={href(lang, 'videos') + `?cat=${v.cat}`} style={`color:${c.ink};background:${c.bg}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z" /><circle cx="7.5" cy="7.5" r="1" /></svg>
              {c[lang]}
            </a>
          </p>
          {desc && (
            <div class:list={['desc', { clamped: longDesc }]} id="desc">
              <p id="desc-text">{desc}</p>
              <button type="button" class="desc-toggle" id="desc-toggle" data-more={t.descMore} data-less={t.descLess} aria-expanded="false" aria-controls="desc-text" hidden={!longDesc}>{t.descMore}</button>
            </div>
          )}
        </div>

        <div class="share" data-url={pageUrl}>
          <button type="button" class="sbtn" id="copy" data-done={t.copied}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1" /></svg>
            <span id="copy-label">{t.copyLink}</span>
          </button>
          <a class="sbtn" href={`https://wa.me/?text=${encodeURIComponent(title(v, lang) + ' ' + pageUrl)}`} rel="noopener" target="_blank">{t.shareWhatsApp}</a>
          <a class="sbtn" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`} rel="noopener" target="_blank">{t.shareFacebook}</a>
          <a class="sbtn plain" href={yt} rel="noopener" target="_blank">{t.watchOnYoutube}</a>
        </div>

        <Comments id={v.id} lang={lang} />

        <div class="ask">
          <div>
            <p class="ask-title">{t.questionTitle}</p>
            <p>{t.questionBody}</p>
          </div>
          <a class="btn" href={href(lang, 'contact') + `?v=${v.id}`}>{t.sendQuestion}</a>
        </div>

        {(prev || next) && (
          <nav class="pn" aria-label={c[lang]}>
            {prev ? <a href={href(lang, `watch/${prev.id}`)}><span class="muted">{t.prev}</span><span>{title(prev, lang)}</span></a> : <span></span>}
            {next ? <a class="r" href={href(lang, `watch/${next.id}`)}><span class="muted">{t.next}</span><span>{title(next, lang)}</span></a> : <span></span>}
          </nav>
        )}

        <section class="also" aria-labelledby="also-h">
          <h2 id="also-h">{t.alsoUseful}</h2>
          <div class="vgrid">
            {also.map((a) => <VideoCard v={a} lang={lang} />)}
          </div>
        </section>
      </article>

      <aside class="side" aria-labelledby="side-h">
        <div class="side-head">
          <h2 id="side-h">{t.moreInTopic}</h2>
          <span class="muted small">{num(idx + 1, lang)} / {num(series.length, lang)}</span>
        </div>
        <ol class="series" id="series" data-size={PAGE}>
          {series.map((s, i) => (
            <li class={pages > 1 && Math.floor(i / PAGE) !== page0 ? 'off' : undefined}>
              <a href={href(lang, `watch/${s.id}`)} aria-current={s.id === v.id ? 'true' : undefined} class={s.id === v.id ? 'cur' : ''}>
                <span class="mini"><Thumb id={s.id} sizes="132px" width="132" height="74" loading="lazy" decoding="async" /></span>
                <span class="mt"><span class="mtitle">{title(s, lang)}</span></span>
              </a>
            </li>
          ))}
        </ol>
        {pages > 1 && (
          <div class="pager" id="pager" data-bn={lang === 'bn' ? '1' : undefined} data-page={page0}>
            <button type="button" id="pg-prev" aria-label={arrowless(t.prev)} disabled={page0 === 0}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
            </button>
            <span class="pg-info" id="pg-info" aria-live="polite">{num(page0 + 1, lang)} / {num(pages, lang)}</span>
            <button type="button" id="pg-next" aria-label={arrowless(t.next)} disabled={page0 === pages - 1}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
            </button>
          </div>
        )}
        {pages > 3 && <a class="more" href={href(lang, 'videos') + `?cat=${v.cat}`}>{t.allInTopic(c[lang])}</a>}

      </aside>
    </div>

  </div>

  <script>
    // Long descriptions: three lines, with a toggle.
    const desc = document.getElementById('desc');
    const dBtn = document.getElementById('desc-toggle') as HTMLButtonElement | null;
    if (desc && dBtn && desc.classList.contains('clamped')) {
      const text = document.getElementById('desc-text')!;
      if (text.scrollHeight > text.clientHeight + 1) {
        dBtn.addEventListener('click', () => {
          const open = desc.classList.toggle('clamped') === false;
          dBtn.textContent = open ? dBtn.dataset.less! : dBtn.dataset.more!;
          dBtn.setAttribute('aria-expanded', String(open));
        });
      } else { desc.classList.remove('clamped'); dBtn.hidden = true; }
    }

    // Topic list: show a few videos at a time, starting on the page that holds the current one.
    const list = document.getElementById('series');
    const pager = document.getElementById('pager');
    if (list && pager) {
      const items = [...list.children] as HTMLElement[];
      const size = Number(list.dataset.size);
      const pages = Math.ceil(items.length / size);
      let page = Number(pager.dataset.page);
      const bn = pager.dataset.bn === '1';
      const num = (x: number) => (bn ? String(x).replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[+d]) : String(x));
      const prev = document.getElementById('pg-prev') as HTMLButtonElement;
      const next = document.getElementById('pg-next') as HTMLButtonElement;
      const info = document.getElementById('pg-info')!;
      const show = () => {
        items.forEach((li, i) => { li.classList.toggle('off', Math.floor(i / size) !== page); });
        info.textContent = `${num(page + 1)} / ${num(pages)}`;
        prev.disabled = page === 0;
        next.disabled = page === pages - 1;
      };
      prev.addEventListener('click', () => { page--; show(); });
      next.addEventListener('click', () => { page++; show(); });
    }
    const btn = document.getElementById('copy') as HTMLButtonElement | null;
    btn?.addEventListener('click', async () => {
      const url = (btn.closest('.share') as HTMLElement).dataset.url!;
      try { await navigator.clipboard.writeText(url); } catch { const i = document.createElement('input'); i.value = url; document.body.appendChild(i); i.select(); document.execCommand('copy'); i.remove(); }
      const label = document.getElementById('copy-label')!;
      const orig = label.textContent;
      label.textContent = btn.dataset.done!;
      setTimeout(() => (label.textContent = orig), 2000);
    });
  </script>
</Base>

<style>
  .watch { padding-top: 24px; padding-bottom: 32px; display: flex; flex-direction: column; gap: 24px; }
  .crumbs { font-size: 15px; color: var(--ink-3); }
  .layout { display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-start; }
  .main-col { flex: 999 1 640px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .meta { display: flex; flex-direction: column; gap: 8px; }
  .pill { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; padding: 4px 12px; border-radius: 999px; text-decoration: none; }
  .meta h1 { font-size: clamp(26px, 3.2vw, 38px); line-height: 1.35; letter-spacing: 0; }
  .stats { font-size: 15px; color: var(--ink-3); display: flex; flex-wrap: wrap; align-items: center; gap: 6px 16px; }
  .st { display: inline-flex; align-items: center; gap: 6px; }
  .stats svg { width: 18px; height: 18px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .pill svg { width: 16px; }
  .desc { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; }
  .desc p { max-width: 44em; white-space: pre-line; color: var(--ink-2); font-size: 17px; line-height: 1.7; }
  :global(html:not(.js)) .desc-toggle { display: none; }
  :global(.js) .desc.clamped p { white-space: normal; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .desc-toggle { background: none; border: 0; padding: 8px 0; min-height: 44px; color: var(--teal); font-weight: 700; font-size: 16px; cursor: pointer; }
  .share { display: flex; flex-wrap: wrap; gap: 8px; }
  .sbtn { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border: 1px solid #cfcac0; background: #fff; border-radius: 10px; font-size: 15px; font-weight: 600; color: var(--ink); text-decoration: none; cursor: pointer; }
  .sbtn:hover { background: var(--sand); color: var(--ink); }
  .sbtn.plain { border-color: transparent; background: none; color: var(--teal); }
  .ask { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding: 24px 28px; background: var(--teal-tint); border-radius: 14px; }
  .ask > div { flex: 1 1 320px; display: flex; flex-direction: column; gap: 4px; }
  .ask-title { font-size: 20px; font-weight: 700; color: #0b4a44; }
  .ask p:not(.ask-title) { font-size: 16px; color: #24524d; }
  .pn { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; }
  .pn a { flex: 1 1 260px; display: flex; flex-direction: column; gap: 2px; padding: 14px 18px; border: 1px solid var(--line); border-radius: 12px; background: #fff; text-decoration: none; color: var(--ink); font-weight: 600; font-size: 16px; line-height: 1.5; }
  .pn a:hover { border-color: var(--teal); }
  .pn a.r { text-align: right; }
  .pn .muted { font-size: 13px; font-weight: 500; }
  .pn > span:empty { display: none; }
  .side { flex: 1 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 16px; position: sticky; top: 16px; max-height: calc(100vh - 32px); }
  .side-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .side-head h2 { font-size: 20px; }
  .small { font-size: 14px; }
  .pager { display: flex; align-items: center; justify-content: center; gap: 16px; }
  :global(html:not(.js)) .pager { display: none; }
  :global(.js) .series li.off { display: none; }
  .pager button { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; padding: 0; border: 1.5px solid var(--teal); border-radius: 12px; background: #fff; color: var(--teal); cursor: pointer; }
  .pager button:hover:not(:disabled) { background: var(--teal-tint); }
  .pager button:disabled { border-color: var(--line); color: var(--ink-3); opacity: 0.5; cursor: default; }
  .pager svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .pg-info { min-width: 4em; text-align: center; font-weight: 600; color: var(--ink-3); }
  .series { display: flex; flex-direction: column; gap: 6px; overflow-y: auto; min-height: 0; padding: 2px; margin: -2px; }
  .series a { position: relative; display: flex; gap: 12px; align-items: flex-start; padding: 10px; border: 1.5px solid transparent; border-radius: 12px; text-decoration: none; color: var(--ink); -webkit-tap-highlight-color: transparent; transition: background-color 0.15s, border-color 0.15s; }
  .series a:hover { background: var(--sand); }
  .series a:active { background: #ece6d9; }
  .series a:focus-visible { outline: 2.5px solid var(--teal); outline-offset: 1px; }
  .series a.cur { background: var(--teal-tint); border-color: var(--teal); cursor: default; }
  .series a.cur .mtitle { color: #0b4a44; }
  .series a.cur .mini { box-shadow: 0 0 0 2px var(--teal); }
  .mini { flex: 0 0 132px; aspect-ratio: 16 / 9; border-radius: 8px; overflow: hidden; background: var(--sand); }
  .mini img { width: 100%; height: 100%; object-fit: cover; }
  .mt { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .mtitle { font-size: 16px; font-weight: 600; line-height: 1.45; }
  .more { font-weight: 600; font-size: 16px; padding: 8px 0; }
  .also { display: flex; flex-direction: column; gap: 20px; padding-top: 16px; }
  .also .vgrid { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .also h2 { font-size: 26px; }
  @media (max-width: 640px) {
    .watch { padding-top: 0; gap: 16px; }
    .crumbs { display: none; }
    .mini { flex-basis: 112px; }
    .ask { padding: 18px; }
    .side { position: static; max-height: none; }
    .series { max-height: 520px; }
  }
</style>
