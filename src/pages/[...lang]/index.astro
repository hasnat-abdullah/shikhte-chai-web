---
import Base from '../../layouts/Base.astro';
import VideoCard from '../../components/VideoCard.astro';
import type { Lang } from '../../data/categories';
import { CATEGORIES, CAT } from '../../data/categories';
import { VIDEOS, thumb, title, countFor, catCount, meta, shelfOf, byCat } from '../../data/videos';
import { START_PATH, FEELINGS } from '../../data/curated';
import { tr, num, href } from '../../i18n/ui';
import { SITE } from '../../config';
import { ICON } from '../../components/icons';
import Helpline from '../../components/Helpline.astro';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'en' } }];
}
const lang: Lang = Astro.params.lang === 'en' ? 'en' : 'bn';
const t = tr(lang);
const byId = new Map(VIDEOS.map((v) => [v.id, v]));
const get = (id: string) => byId.get(id)!;
// Hero: a random mental-health video on every visit (picked in the browser).
// The most-viewed one is rendered in the HTML as the default for search engines and no-JS visitors.
const heroPool = VIDEOS.filter((v) => shelfOf(v) === 'mental');
const featured = [...heroPool].sort((a, b) => (meta(b.id)?.views ?? 0) - (meta(a.id)?.views ?? 0))[0];
const fc = CAT[featured.cat];
const heroData = heroPool.map((v) => ({ id: v.id, href: href(lang, `watch/${v.id}`), t: title(v, lang), c: CAT[v.cat][lang], bg: CAT[v.cat].bg }));
const mental = CATEGORIES.filter((c) => c.shelf === 'mental');
const science = CATEGORIES.filter((c) => c.shelf === 'science');
const nMental = countFor('mental');
const nScience = countFor('science');
// Most viewed mental-health videos, from live channel stats.
const popular = VIDEOS.filter((v) => shelfOf(v) === 'mental').sort((a, b) => (meta(b.id)?.views ?? 0) - (meta(a.id)?.views ?? 0)).slice(0, 4);
// Show a "new videos" row only when the channel has uploaded within the last year.
const yearAgo = new Date(Date.now() - 365 * 86400000).toISOString().slice(0, 10);
const latest = VIDEOS.filter((v) => (meta(v.id)?.date ?? '') >= yearAgo).slice(0, 4);
---
<Base lang={lang} nav="home">
  <section class="wrap hero">
    <div class="hero-copy">
      <p class="eyebrow">{t.heroEyebrow}</p>
      <h1>{t.heroTitle[0]}<br />{t.heroTitle[1]}</h1>
      <p class="lead">{t.heroLead(num(VIDEOS.length + 1, lang))}</p>
      <form class="hero-search" role="search" action={href(lang, 'videos')} method="get">
        <label for="hero-q">{t.searchLabel}</label>
        <div class="row">
          <input id="hero-q" name="q" type="search" placeholder={t.searchPlaceholder} autocomplete="off" />
          <button class="btn" type="submit">{t.searchBtn}</button>
        </div>
        <p class="hero-try"><span class="muted">{t.trySearch}</span> {t.searchSuggestions.map((q) => <a href={href(lang, 'videos') + `?q=${encodeURIComponent(q)}`}>{q}</a>)}</p>
      </form>
    </div>
    <a class="hero-card" id="hero-card" href={href(lang, `watch/${featured.id}`)}>
      <div class="vthumb" id="hero-thumb" style={`background:${fc.bg}`}>
        <img id="hero-img" src={thumb(featured.id)} alt="" width="480" height="360" style="height:100%;object-fit:cover" fetchpriority="high" />
        <span class="vplay hero-play"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="#0B6B63" /></svg></span>
      </div>
      <span class="hero-card-tag" id="hero-tag">{t.heroPick} · {fc[lang]}</span>
      <span class="hero-card-title" id="hero-title">{title(featured, lang)}</span>
    </a>
    <script type="application/json" id="hero-data" set:html={JSON.stringify({ pick: t.heroPick, items: heroData })} />
    <script is:inline>
      (function () {
        var d = JSON.parse(document.getElementById('hero-data').textContent);
        var last; try { last = localStorage.getItem('hero:last'); } catch (e) {}
        var pool = d.items.filter(function (x) { return x.id !== last; });
        var v = pool[Math.floor(Math.random() * pool.length)];
        try { localStorage.setItem('hero:last', v.id); } catch (e) {}
        document.getElementById('hero-card').href = v.href;
        document.getElementById('hero-thumb').style.background = v.bg;
        document.getElementById('hero-img').src = 'https://i.ytimg.com/vi/' + v.id + '/hqdefault.jpg';
        document.getElementById('hero-tag').textContent = d.pick + ' · ' + v.c;
        document.getElementById('hero-title').textContent = v.t;
      })();
    </script>
  </section>

  <section class="feel" aria-labelledby="feel-h">
    <div class="wrap stack">
      <div>
        <h2 id="feel-h">{t.feelTitle}</h2>
        <p class="muted">{t.feelLead}</p>
      </div>
      <div class="chips" role="group" aria-label={t.feelGroup} id="feel-chips">
        {FEELINGS.map((f, i) => (
          <button type="button" class="chip" data-cat={f.cat} aria-pressed={i === 0 ? 'true' : 'false'}>{f[lang]}</button>
        ))}
      </div>
      {FEELINGS.map((f, i) => (
        <div class="feel-panel" data-panel={f.cat} hidden={i !== 0}>
          <p class="muted small-p">{t.forYou} <a href={href(lang, 'videos') + `?cat=${f.cat}`}><strong>{t.feelSeeAll(CAT[f.cat][lang], num(catCount(f.cat), lang))}</strong></a></p>
          <div class="vgrid three">
            {f.picks.map((id) => <VideoCard v={get(id)} lang={lang} showCat={false} />)}
          </div>
        </div>
      ))}
      <script is:inline>
        (function () {
          var chips = [].slice.call(document.querySelectorAll('#feel-chips .chip'));
          var panels = [].slice.call(document.querySelectorAll('.feel-panel'));
          function select(cat, scroll) {
            chips.forEach(function (c) {
              var on = c.getAttribute('data-cat') === cat;
              c.setAttribute('aria-pressed', on ? 'true' : 'false');
              if (on && scroll) c.scrollIntoView({ inline: 'center', block: 'nearest' });
            });
            panels.forEach(function (p) { p.hidden = p.getAttribute('data-panel') !== cat; });
          }
          chips.forEach(function (c) { c.addEventListener('click', function () { select(c.getAttribute('data-cat'), false); }); });
          // Start on a different feeling each visit; the videos for each feeling are always the same best matches.
          var last; try { last = localStorage.getItem('feel:last'); } catch (e) {}
          var options = chips.map(function (c) { return c.getAttribute('data-cat'); }).filter(function (c) { return c !== last; });
          var start = options[Math.floor(Math.random() * options.length)];
          try { localStorage.setItem('feel:last', start); } catch (e) {}
          select(start, true);
        })();
      </script>
    </div>
  </section>

  <section class="wrap stack section" aria-labelledby="topics-h">
    <div class="sec-head">
      <div>
        <h2 id="topics-h">{t.topicsTitle}</h2>
        <p class="muted">{t.topicsLead(num(nMental, lang), num(mental.length, lang))}</p>
      </div>
      <a class="more" href={href(lang, 'videos')}>{t.seeAll}</a>
    </div>
    <div class="topic-grid">
      {mental.map((c) => (
        <a class="topic" href={href(lang, 'videos') + `?cat=${c.id}`}>
          <span class="topic-icon" style={`background:${c.bg}`}><svg viewBox="0 0 24 24" fill="none" stroke={c.ink} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.icon} /></svg></span>
          <span class="topic-name">{c[lang]}</span>
          <span class="topic-desc">{lang === 'bn' ? c.descBn : c.descEn}</span>
          <span class="topic-count" style={`color:${c.ink}`}>{t.videosCount(num(catCount(c.id), lang))}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap path section" aria-labelledby="start-h">
    <div class="path-intro">
      <p class="eyebrow">{t.newHere}</p>
      <h2 id="start-h">{t.pathTitle}</h2>
      <p class="muted">{t.pathLead}</p>
    </div>
    <ol class="path-list">
      {START_PATH.map((id, i) => {
        const v = get(id);
        return (
          <li>
            <a href={href(lang, `watch/${id}`)}>
              <span class="step">{num(i + 1, lang)}</span>
              <span class="step-text"><span class="step-title">{title(v, lang)}</span></span>
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#0B6B63" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICON.chevron} /></svg>
            </a>
          </li>
        );
      })}
    </ol>
  </section>

  {latest.length > 0 && (
    <section class="wrap stack section" aria-labelledby="new-h">
      <h2 id="new-h">{t.latestTitle}</h2>
      <div class="vgrid">{latest.map((v) => <VideoCard v={v} lang={lang} />)}</div>
    </section>
  )}

  <section class="wrap stack section" aria-labelledby="pop-h">
    <h2 id="pop-h">{t.popularTitle}</h2>
    <div class="vgrid">
      {popular.map((v) => <VideoCard v={v} lang={lang} showViews />)}
    </div>
  </section>

  <section class="sci" aria-labelledby="sci-h">
    <div class="wrap stack">
      <div class="sec-head">
        <div>
          <h2 id="sci-h">{t.scienceTitle}</h2>
          <p class="muted">{t.scienceLead(num(nScience, lang))}</p>
        </div>
        <a class="more" href={href(lang, 'videos') + '?shelf=science'}>{t.seeAllShort}</a>
      </div>
      <div class="sci-grid">
        {science.map((c) => (
          <a class="sci-card" href={href(lang, 'videos') + `?cat=${c.id}`} style={`background:${c.ink}`} data-ids={byCat(c.id).map((v) => v.id).join(',')}>
            <img class="sci-bg" alt="" width="480" height="360" />
            <span class="sci-shade" aria-hidden="true"></span>
            <span class="sci-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.icon} /></svg></span>
            <span class="sci-text"><span class="sci-name">{c[lang]}</span><span class="sci-count">{t.videosCount(num(catCount(c.id), lang))}</span></span>
          </a>
        ))}
      </div>
      <script is:inline>
        // A random video thumbnail behind each card, different on every visit.
        document.querySelectorAll('.sci-card').forEach(function (card) {
          var ids = card.getAttribute('data-ids').split(',');
          var img = card.querySelector('.sci-bg');
          img.addEventListener('load', function () { img.classList.add('on'); });
          img.src = 'https://i.ytimg.com/vi/' + ids[Math.floor(Math.random() * ids.length)] + '/hqdefault.jpg';
        });
      </script>
    </div>
  </section>

  <div class="wrap section"><Helpline lang={lang} /></div>

  <section class="wrap cta-pair section" aria-labelledby="help-h">
    <div class="callout-warm">
      <h2 id="help-h" class="h-sm">{t.helpTitle}</h2>
      <p>{t.helpBody}</p>
      <div class="chips">
        <a class="btn btn-warm" href={`tel:${SITE.emergencyNumber}`}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICON.phone} /></svg>{t.callEmergency(num(SITE.emergencyNumber, lang))}</a>
        <a class="btn btn-outline" href={href(lang, 'find-help')}>{t.findHelpCta}</a>
      </div>
    </div>
    <div class="callout-teal">
      <h2 class="h-sm">{t.listenTitle}</h2>
      <p>{t.listenBody}</p>
      <div><a class="btn btn-white" href={href(lang, 'contact')}>{t.nav.contact}</a></div>
    </div>
  </section>

</Base>

<style>
  .hero { padding-top: 64px; padding-bottom: 48px; display: flex; flex-wrap: wrap; gap: 48px; align-items: center; }
  .hero-copy { flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .lead { font-size: 20px; line-height: 1.7; color: var(--ink-2); max-width: 34em; }
  .hero-search { display: flex; flex-direction: column; gap: 6px; max-width: 560px; margin-top: 8px; }
  .hero-search label { font-size: 15px; font-weight: 600; }
  .hero-search .row { display: flex; flex-wrap: wrap; gap: 8px; }
  .hero-search input { flex: 1 1 260px; min-width: 0; }
  .hero-search .btn { min-height: 52px; }
  .hero-try { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; font-size: 15px; }
  .hero-try a { padding: 10px 12px; min-height: 44px; display: inline-flex; align-items: center; border: 1px solid var(--line-strong); border-radius: 999px; background: #fff; text-decoration: none; font-weight: 500; }
  .hero-try a:hover { border-color: var(--teal); }
  .hero-card { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 6px; padding: 16px; background: var(--card); border: 1px solid var(--line); border-radius: 16px; text-decoration: none; color: inherit; }
  .hero-card:hover { border-color: var(--teal); color: inherit; }
  .hero-play { width: 56px; height: 56px; left: 16px; bottom: 16px; }
  .hero-play svg { width: 22px; height: 22px; }
  .hero-card-tag { font-size: 14px; font-weight: 600; color: #0b5a53; padding: 8px 8px 0; }
  .hero-card-title { font-size: 22px; font-weight: 700; line-height: 1.4; padding: 0 8px 8px; }

  .feel { background: var(--card); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 56px 0; }
  .stack { display: flex; flex-direction: column; gap: 24px; }
  .section { padding-top: 56px; padding-bottom: 8px; }
  .small-p { margin-bottom: 16px; }
  .vgrid.three { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }

  .sec-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 12px; }
  .more { font-weight: 600; font-size: 17px; padding: 10px 0; }

  .topic-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .topic { display: flex; flex-direction: column; gap: 10px; padding: 24px; border-radius: 14px; background: var(--card); border: 1px solid var(--line); text-decoration: none; color: var(--ink); min-height: 188px; }
  .topic:hover { border-color: var(--teal); color: var(--ink); }
  .topic-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
  .topic-icon svg { width: 26px; height: 26px; }
  .topic-name { font-size: 19px; font-weight: 700; line-height: 1.4; }
  .topic-desc { font-size: 15px; line-height: 1.6; color: var(--ink-2); }
  .topic-count { margin-top: auto; font-size: 14px; font-weight: 600; }
  .sci-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
  .sci-card { position: relative; overflow: hidden; isolation: isolate; min-height: 190px; border-radius: 14px; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; padding: 18px 20px; color: #fff; text-decoration: none; }
  .sci-card:hover { color: #fff; }
  .sci-bg { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.4s, transform 0.4s; }
  .sci-bg.on { opacity: 1; }
  .sci-card:hover .sci-bg { transform: scale(1.04); }
  .sci-shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgba(10,14,18,0.88) 0%, rgba(10,14,18,0.5) 50%, rgba(10,14,18,0.15) 100%); }
  .sci-icon { width: 44px; height: 44px; border-radius: 12px; background: rgba(255,255,255,0.18); backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center; }
  .sci-icon svg { width: 24px; height: 24px; }
  .sci-text { display: flex; flex-direction: column; line-height: 1.4; }
  .sci-name { font-size: 22px; font-weight: 700; }
  .sci-count { font-size: 15px; font-weight: 500; color: #e6eaed; }
  @media (prefers-reduced-motion: reduce) { .sci-bg, .sci-card:hover .sci-bg { transition: none; transform: none; } }

  .path { display: flex; flex-wrap: wrap; gap: 40px; }
  .path-intro { flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
  .path-intro .muted { max-width: 26em; }
  .path-list { flex: 999 1 560px; min-width: 0; border-top: 1px solid var(--line); }
  .path-list li { border-bottom: 1px solid var(--line); }
  .path-list a { display: flex; align-items: center; gap: 20px; padding: 20px 4px; text-decoration: none; color: var(--ink); }
  .path-list a:hover .step-title { text-decoration: underline; text-underline-offset: 3px; }
  .step { flex: 0 0 44px; width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid var(--teal); color: var(--teal); display: flex; align-items: center; justify-content: center; font-weight: 700; }
  .step-text { flex: 1; display: flex; flex-direction: column; }
  .step-title { font-size: 19px; font-weight: 600; line-height: 1.45; }

  .sci { background: var(--sand); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 56px 0; margin-top: 56px; }
  .sci h2 { font-size: 28px; }

  .cta-pair { display: flex; flex-wrap: wrap; gap: 24px; padding-top: 24px; padding-bottom: 16px; }
  .cta-pair > div { flex: 1 1 420px; min-width: 0; }
  .h-sm { font-size: 26px; line-height: 1.35; }

  @media (max-width: 640px) {
    .hero { padding-top: 32px; gap: 28px; }
    .feel, .sci { padding: 36px 0; }
    .section { padding-top: 40px; }
    .topic-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .topic-grid .topic { padding: 14px; min-height: 128px; gap: 8px; }
    .topic-grid .topic-desc { display: none; }
    .topic-grid .topic-icon { width: 40px; height: 40px; }
    .topic-grid .topic-name { font-size: 15px; }
    .topic-grid .topic-count { font-size: 13px; }
    .lead { font-size: 18px; }
    .hero-card-title { font-size: 19px; }
    .callout-warm, .callout-teal { padding: 22px; }
    .h-sm { font-size: 21px; }
    .sci-card { min-height: 150px; }
    .chips { flex-wrap: nowrap; overflow-x: auto; margin: 0 -24px; padding: 0 24px 4px; }
    #feel-chips .chip { flex: 0 0 auto; }
  }
</style>
