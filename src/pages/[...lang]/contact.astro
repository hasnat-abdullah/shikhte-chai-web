---
import Base from '../../layouts/Base.astro';
import type { Lang } from '../../data/categories';
import { tr, num, href } from '../../i18n/ui';
import { SITE } from '../../config';
import Helpline from '../../components/Helpline.astro';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'en' } }];
}
const lang: Lang = Astro.params.lang === 'en' ? 'en' : 'bn';
const t = tr(lang);
const cfg = { key: SITE.formKey, err: t.errorMsg, off: t.notConfigured, req: t.requiredMsg, sending: t.sending, send: t.send };
---
<Base lang={lang} path="contact" nav="contact" title={t.contactTitle} description={t.contactLead}>
  <div class="wrap contact">
    <div class="col-main">
      <div class="head">
        <h1>{t.contactTitle}</h1>
        <p class="lead">{t.contactLead}</p>
      </div>

      <div id="sent" class="sent" role="status" tabindex="-1" hidden>
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#0b6b63" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.5 2.5L16 9.5" /></svg>
        <h2>{t.sentTitle}</h2>
        <p>{t.sentBody}</p>
        <div class="chips">
          <a class="btn" href={href(lang, 'videos')}>{t.seeVideos}</a>
          <button type="button" class="btn btn-outline" id="again">{t.another}</button>
        </div>
      </div>

      <form id="form" novalidate>
        <fieldset class="topics">
          <legend>{t.aboutWhat}</legend>
          <div class="topic-grid">
            {t.topics.map((tp, i) => (
              <label class="tcard">
                <input type="radio" name="topic" value={tp.id} data-ph={tp.placeholder} data-label={tp.label} checked={i === 0} />
                <span class="tlabel">{tp.label}</span>
                <span class="thint">{tp.hint}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <label class="anon">
          <input type="checkbox" id="anon" />
          <span><strong>{t.anonTitle}</strong><span class="muted">{t.anonBody}</span></span>
        </label>

        <div id="identity" class="identity">
          <div class="field">
            <label for="c-name">{t.yourName} <span class="muted opt">{t.optional}</span></label>
            <input id="c-name" name="name" type="text" autocomplete="name" />
          </div>
          <div class="field">
            <label for="c-email">{t.yourContact}</label>
            <input id="c-email" name="email" type="email" autocomplete="email" />
          </div>
        </div>

        <div class="field">
          <label for="c-msg">{t.yourMessage}</label>
          <textarea id="c-msg" name="message" rows="7" required aria-describedby="msg-err"></textarea>
          <p id="msg-err" class="err" role="alert" hidden></p>
        </div>

        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <p id="form-err" class="err" role="alert" hidden></p>

        <div class="actions">
          <button type="submit" class="btn big" id="submit">{t.send}</button>
          <span class="muted note">{t.consent}</span>
        </div>
      </form>
    </div>

    <aside class="col-side">
      <div class="callout-warm">
        <h2 class="h-s">{t.notEmergencyTitle}</h2>
        <p class="body-s">{t.notEmergencyBody}</p>
        <div><a class="btn btn-warm" href={`tel:${SITE.emergencyNumber}`}>{t.callEmergency(num(SITE.emergencyNumber, lang))}</a></div>
      </div>
      <Helpline lang={lang} compact />
      <div class="other">
        <h2 class="h-s">{t.otherWays}</h2>
        <a href={SITE.youtube} target="_blank" rel="noopener noreferrer">YouTube: @ShikhteChaiBD ↗</a>
        {SITE.facebook && <a href={SITE.facebook} target="_blank" rel="noopener noreferrer">{t.facebookPage}</a>}
      </div>
    </aside>
  </div>

  <script type="application/json" id="contact-cfg" set:html={JSON.stringify(cfg)} />
  <script src="../../scripts/contact.ts"></script>
</Base>

<style>
  .contact { padding-top: 48px; padding-bottom: 32px; display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start; max-width: 1100px; }
  .col-main { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 28px; }
  .col-side { flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .head { display: flex; flex-direction: column; gap: 10px; }
  .head h1 { font-size: clamp(32px, 4vw, 44px); }
  .lead { font-size: 19px; color: var(--ink-2); max-width: 34em; }
  form { display: flex; flex-direction: column; gap: 28px; }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  legend { padding: 0; margin-bottom: 12px; font-size: 18px; font-weight: 700; }
  .topic-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
  .tcard { position: relative; display: flex; flex-direction: column; gap: 2px; padding: 14px 16px; border-radius: 12px; border: 2px solid var(--line); background: #fff; cursor: pointer; }
  .tcard input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .tcard:has(input:checked) { background: var(--teal-tint); border-color: var(--teal); }
  .tcard:has(input:focus-visible) { outline: 3px solid var(--teal); outline-offset: 2px; }
  .tlabel { font-size: 17px; font-weight: 700; }
  .thint { font-size: 14px; line-height: 1.5; color: var(--ink-3); }
  .anon { display: flex; align-items: flex-start; gap: 14px; padding: 16px 18px; border-radius: 12px; background: #fff; border: 1px solid var(--line); cursor: pointer; }
  .anon input { width: 22px; height: 22px; margin: 4px 0 0; accent-color: var(--teal); flex: 0 0 auto; }
  .anon span { display: flex; flex-direction: column; font-size: 17px; }
  .anon .muted { font-size: 15px; }
  .identity { display: flex; flex-wrap: wrap; gap: 20px; }
  .field { flex: 1 1 240px; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .field label { font-size: 16px; font-weight: 600; }
  .opt { font-weight: 400; }
  .err { color: #a02a12; font-size: 15px; font-weight: 600; }
  .hp { position: absolute; left: -9999px; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  .big { min-height: 56px; padding: 0 32px; font-size: 18px; font-weight: 700; border-radius: 12px; }
  .big[disabled] { opacity: 0.7; cursor: progress; }
  .note { font-size: 14px; max-width: 28em; }
  .sent { padding: 32px; border-radius: 16px; background: var(--teal-tint); border: 1px solid #b5dcd5; display: flex; flex-direction: column; gap: 12px; }
  .sent h2 { color: #0b4a44; font-size: 26px; }
  .sent p { color: #24524d; max-width: 32em; }
  .h-s { font-size: 19px; }
  .body-s { font-size: 16px; line-height: 1.65; }
  .other { padding: 24px; border-radius: 16px; background: #fff; border: 1px solid var(--line); display: flex; flex-direction: column; gap: 8px; }
  .other a { font-size: 16px; padding: 4px 0; }
  @media (max-width: 640px) { .contact { padding-top: 28px; gap: 32px; } }
</style>
