---
import type { Lang } from '../data/categories';
import { tr, num } from '../i18n/ui';
import { SITE } from '../config';
interface Props { lang: Lang; compact?: boolean }
const { lang, compact = false } = Astro.props;
const t = tr(lang);
const H = SITE.helpline;
const shown = lang === 'bn' ? num(H.display, 'bn') : H.display;
---
<section class:list={['helpline', { compact }]} aria-labelledby={compact ? undefined : 'helpline-h'} aria-label={compact ? t.helplineName : undefined} data-open={H.openHour} data-close={H.closeHour}>
  <div class="hl-text">
    <p class="hl-brand">{t.helplineName}</p>
    {compact ? <p class="hl-title">{t.helplineTitle}</p> : <h2 id="helpline-h" class="hl-title">{t.helplineTitle}</h2>}
    <p class="hl-body">{t.helplineBody}</p>
    <p class="hl-hours">
      <span>{t.helplineHours}</span>
      <span class="hl-status" id={compact ? undefined : 'hl-status'} data-open-text={t.helplineOpen} data-closed-text={t.helplineClosed} hidden></span>
    </p>
  </div>
  <div class="hl-action">
    <a class="hl-call" href={`tel:${H.number}`}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
      <span class="hl-num">{shown}</span>
    </a>
    <a class="hl-fb" href={H.facebook} rel="noopener" target="_blank">{t.helplineFacebook}</a>
    <p class="hl-note">{t.helplineNote}</p>
  </div>
</section>

<script>
  // Shows whether the helpline is open right now, in Bangladesh time.
  document.querySelectorAll<HTMLElement>('.helpline').forEach((root) => {
    const open = Number(root.dataset.open), close = Number(root.dataset.close);
    const el = root.querySelector<HTMLElement>('.hl-status');
    if (!el) return;
    const hour = Number(new Intl.DateTimeFormat('en-GB', { hour: '2-digit', hour12: false, timeZone: 'Asia/Dhaka' }).format(new Date())) % 24;
    const isOpen = open > close ? hour >= open || hour < close : hour >= open && hour < close;
    el.textContent = isOpen ? el.dataset.openText! : el.dataset.closedText!;
    el.dataset.state = isOpen ? 'open' : 'closed';
    el.hidden = false;
  });
</script>

<style>
  .helpline { display: flex; flex-wrap: wrap; gap: 24px 40px; align-items: center; padding: 32px; border-radius: 18px; background: #fdf3e3; border: 1px solid #ecd3a8; color: #3b2a12; }
  .hl-text { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .hl-brand { font-size: 14px; font-weight: 700; letter-spacing: 0.03em; color: #7a4a06; }
  .hl-title { font-size: clamp(24px, 3vw, 30px); line-height: 1.35; font-weight: 700; color: #4a2c05; }
  .hl-body { font-size: 17px; max-width: 36em; }
  .hl-hours { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; font-size: 16px; font-weight: 600; }
  .hl-status { display: inline-flex; align-items: center; gap: 8px; padding: 2px 12px; border-radius: 999px; font-size: 14px; background: #fff; border: 1px solid #ecd3a8; }
  .hl-status::before { content: ''; width: 9px; height: 9px; border-radius: 50%; background: #1d7a45; }
  .hl-status[data-state='closed']::before { background: #8a8f94; }
  .hl-action { flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .hl-call { display: inline-flex; align-items: center; gap: 12px; min-height: 60px; padding: 0 28px; border-radius: 14px; background: #7a4a06; color: #fff; text-decoration: none; font-size: 24px; font-weight: 700; letter-spacing: 0.01em; }
  .hl-call:hover { background: #5f3804; color: #fff; }
  .hl-fb { font-size: 15px; font-weight: 600; color: #7a4a06; padding: 8px 0; }
  .hl-fb:hover { color: #5f3804; }
  .hl-note { font-size: 14px; line-height: 1.6; color: #5b4527; max-width: 34em; }

  .compact { flex-direction: column; align-items: stretch; padding: 22px; gap: 16px; border-radius: 16px; }
  .compact .hl-title { font-size: 19px; }
  .compact .hl-body { font-size: 15px; line-height: 1.65; }
  .compact .hl-hours { font-size: 15px; }
  .compact .hl-call { min-height: 52px; font-size: 20px; padding: 0 20px; justify-content: center; }
  .compact .hl-text, .compact .hl-action { flex: 0 0 auto; }
  @media (max-width: 640px) { .helpline { padding: 22px; } .hl-call { width: 100%; justify-content: center; } }
</style>
