---
import type { Lang } from '../data/categories';
import { tr } from '../i18n/ui';
interface Props { id: string; lang: Lang }
const { id, lang } = Astro.props;
const t = tr(lang);
const yt = `https://www.youtube.com/watch?v=${id}`;
---
<section class="comments" aria-labelledby="cm-h" id="comments">
  <div>
    <h2 id="cm-h">{t.commentsTitle}</h2>
    <p>{t.commentsFallback}</p>
  </div>
  <a class="btn btn-outline" href={yt} rel="noopener" target="_blank">{t.commentsWrite}</a>
</section>

<style>
  .comments { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; padding: 18px 20px; border: 1px solid var(--line); border-radius: 14px; background: var(--card); }
  .comments h2 { font-size: 22px; }
  .comments p { color: var(--ink-3); font-size: 16px; }
</style>
