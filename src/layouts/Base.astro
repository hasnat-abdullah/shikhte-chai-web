---
import '@fontsource-variable/inter';
import '@fontsource-variable/noto-sans-bengali';
import '../styles/global.css';
import type { Lang } from '../data/categories';
import { tr, href, num } from '../i18n/ui';
import { SITE } from '../config';
import { ICON } from '../components/icons';

interface Props {
  lang: Lang;
  /** Path without language prefix, e.g. "videos" or "watch/abc". Empty for home. */
  path?: string;
  title?: string;
  description?: string;
  image?: string;
  imageSize?: [number, number];
  nav?: 'home' | 'videos' | 'about' | 'support' | 'help' | 'pros' | 'contact' | '';
  noindex?: boolean;
  /** A page that exists in one language only (no language switch, no alternate links). */
  solo?: boolean;
}
const { lang, path = '', title, description, image, imageSize = [1200, 630], nav = '', noindex = false, solo = false } = Astro.props;
const t = tr(lang);
const other: Lang = lang === 'bn' ? 'en' : 'bn';
const pageTitle = title ? `${title} · ${t.siteName}` : `${t.siteName} · ${t.tagline}`;
const desc = description ?? t.metaDescription;
const canonical = new URL(href(lang, path), SITE.url).href;
const alt = {
  bn: new URL(href('bn', path), SITE.url).href,
  en: new URL(href('en', path), SITE.url).href,
};
const ogImage = image ?? new URL('/og.png', SITE.url).href;
const year = new Date().getFullYear();
const cur = (k: string) => (nav === k ? 'page' : undefined);
const icon = (d: string) => d;
---
<!doctype html>
<html lang={lang === 'bn' ? 'bn' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b6b63" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {!solo && <link rel="alternate" hreflang="bn" href={alt.bn} />}
    {!solo && <link rel="alternate" hreflang="en" href={alt.en} />}
    {!solo && <link rel="alternate" hreflang="x-default" href={alt.bn} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(imageSize[0])} />
    <meta property="og:image:height" content={String(imageSize[1])} />
    <meta property="og:locale" content={lang === 'bn' ? 'bn_BD' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={href(lang)}>
          <svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true"><rect width="36" height="36" rx="10" fill="#0B6B63"/><path d="M18 27c0-6 0-9 0-12M18 15c0-4-3-7-8-7 0 4 3 7 8 7zM18 18c0-3 2.5-6 7-6 0 3.5-2.5 6-7 6z" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="brand-text"><span class="brand-name">{t.siteName}</span><span class="brand-sub">{t.siteNameLatin}</span></span>
        </a>
        <nav class="main-nav" aria-label={t.nav.menu}>
          <a href={href(lang)} aria-current={cur('home')}>{t.nav.home}</a>
          <a href={href(lang, 'videos') + '?shelf=mental'} aria-current={undefined}>{t.nav.mental}</a>
          <a href={href(lang, 'videos') + '?shelf=science'}>{t.nav.science}</a>
          <a href={href(lang, 'professionals')} aria-current={cur('pros')}>{t.nav.pros}</a>
          <a href={href(lang, 'find-help')} aria-current={cur('help')}>{t.nav.help}</a>
          <a href={href(lang, 'support')} aria-current={cur('support')}>{t.nav.support}</a>
        </nav>
        <div class="header-actions">
          {!solo && <a class="lang-switch" href={href(other, path)} hreflang={other} lang={other} aria-label={t.switchLabel}>{t.switchTo}</a>}
          <a class="btn header-cta" href={href(lang, 'contact')}>{t.nav.contact}</a>
          <details class="menu" id="menu">
            <summary class="menu-btn" aria-label={t.nav.menuBtn}>
              <svg class="i-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
              <svg class="i-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
              <span>{t.nav.menuBtn}</span>
            </summary>
            <nav class="menu-panel" aria-label={t.nav.menu}>
              <a href={href(lang)} aria-current={cur('home')}>{t.nav.home}</a>
              <a href={href(lang, 'videos') + '?shelf=mental'}>{t.nav.mental}</a>
              <a href={href(lang, 'videos') + '?shelf=science'}>{t.nav.science}</a>
              <a href={href(lang, 'professionals')} aria-current={cur('pros')}>{t.nav.pros}</a>
              <a href={href(lang, 'find-help')} aria-current={cur('help')}>{t.nav.help}</a>
              <a href={href(lang, 'support')} aria-current={cur('support')}>{t.nav.support}</a>
              <a href={href(lang, 'about')} aria-current={cur('about')}>{t.nav.about}</a>
              <a class="btn menu-cta" href={href(lang, 'contact')}>{t.nav.contact}</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="wrap footer-top">
        <div class="footer-about">
          <strong>{t.siteName}</strong>
          <p>{t.footerAbout}</p>
          <p class="small">{t.disclaimer}</p>
        </div>
        <nav class="footer-nav" aria-label={t.footerLinks}>
          <a href={href(lang, 'videos')}>{t.allVideos}</a>
          <a href={href(lang, 'about')}>{t.nav.about}</a>
          <a href={href(lang, 'professionals')}>{t.nav.pros}</a>
          <a href={href(lang, 'find-help')}>{t.nav.help}</a>
          <a href={href(lang, 'support')}>{t.nav.support}</a>
          <a href={href(lang, 'contact')}>{t.contactLink}</a>
          <a href={SITE.youtube} target="_blank" rel="noopener noreferrer">{t.youtubeChannel}</a>
          {SITE.facebook && <a href={SITE.facebook} target="_blank" rel="noopener noreferrer">{t.facebookPage}</a>}
        </nav>
      </div>
      <div class="wrap footer-bottom">
        <span>{t.rights(year)}</span>
        <span>{t.emergencyShort}: <a class="tel" href={`tel:${SITE.emergencyNumber}`}>{num(SITE.emergencyNumber, lang)}</a> · {t.helplineName}: <a class="tel" href={`tel:${SITE.helpline.number}`}>{lang === 'bn' ? num(SITE.helpline.display, 'bn') : SITE.helpline.display}</a></span>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var menu = document.getElementById('menu');
        if (!menu) return;
        function close() { menu.removeAttribute('open'); }
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && menu.open) { close(); menu.querySelector('summary').focus(); } });
        document.addEventListener('click', function (e) { if (menu.open && !menu.contains(e.target)) close(); });
        window.addEventListener('resize', function () { if (window.innerWidth >= 1200) close(); });
      })();
      document.querySelectorAll('a[href^="http"]').forEach(function (a) {
        if (a.hostname !== location.hostname) { a.target = '_blank'; a.rel = 'noopener noreferrer'; }
      });
    </script>

    <nav class="bottom-nav" aria-label={t.nav.bottom}>
      <a href={href(lang)} aria-current={cur('home')}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon(ICON.home)} /></svg>{t.nav.home}</a>
      <a href={href(lang, 'videos')} aria-current={cur('videos')}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon(ICON.grid)} /></svg>{t.nav.topics}</a>
      <a href={href(lang, 'videos') + '?focus=search'}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d={icon(ICON.search)} /></svg>{t.nav.search}</a>
      <a href={href(lang, 'find-help')} aria-current={cur('help')}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon(ICON.lifebuoy)} /></svg>{t.nav.helpShort}</a>
      <a href={href(lang, 'contact')} aria-current={cur('contact')}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon(ICON.chat)} /></svg>{t.nav.message}</a>
    </nav>
  </body>
</html>
