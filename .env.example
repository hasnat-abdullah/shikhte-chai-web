# Copy this file to .env for local work. Every value is optional: the site still runs without them,
# and the feature that needs a value simply stays switched off. On GitHub, add the same names as
# repository secrets (Settings > Secrets and variables > Actions) so the deployed site has them too.
# These PUBLIC_ values end up in the website's code, so never put a private key here.

# --- Message form (the /contact page) ---------------------------------------------------------
# Free key from https://web3forms.com. Messages are emailed to the inbox you register there.
# Empty: the form shows "not switched on yet".
PUBLIC_WEB3FORMS_KEY=

# --- Professionals directory (/professionals/ and /admin/) -------------------------------------
# Written for you by `npm run setup:supabase` (see README, "Automatic setup"). Both values are public
# by design: the database's access rules decide what visitors can read and write.
# Empty: the directory says it opens soon, the join form is switched off, and /admin/ says it is not connected.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# The secrets used only by the setup script (access token, database password, admin login, email key)
# do NOT belong here. They go in supabase/setup.env, which is kept out of git. See supabase/setup.env.example.
