{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build:*)",
      "Bash(npm run verify:*)",
      "Bash(npm run check:*)",
      "Bash(npm run audit:*)",
      "Bash(npm run thumbs:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run preview:*)",
      "Bash(npm ci)",
      "Bash(npm audit:*)",
      "Bash(npm ls:*)",
      "Bash(node scripts/check-site.mjs:*)",
      "Bash(node scripts/audit.mjs:*)",
      "Bash(node scripts/thumbs.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(npm run sync-videos:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
    ],
    "deny": [
      "Read(./.env)",
      "Read(./supabase/setup.env)",
      "Bash(cat .env:*)",
      "Bash(cat supabase/setup.env:*)",
      "Bash(npm run setup:supabase:*)",
      "Bash(node scripts/supabase-setup.mjs:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase link:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-on-stop.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
