# Copy this file to supabase/setup.env (it is ignored by git), fill it in, then run:  npm run setup:supabase

# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# The "abcdefgh" part of https://abcdefgh.supabase.co
SUPABASE_PROJECT_REF=
# The database password you chose when you created the project
SUPABASE_DB_PASSWORD=

# Your admin login for /admin/. Leave the password empty to have a strong one generated and shown once.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: automatic emails (see README). Leave empty to skip.
RESEND_API_KEY=
# Sender on a domain you verified in Resend, e.g. Shikhte Chai <hello@shikhtechai.com>
EMAIL_FROM=info@shikhtechai
# Where "new request" emails go (defaults to ADMIN_EMAIL)
ADMIN_NOTIFY_EMAIL=
SITE_URL=https://shikhtechai.com
